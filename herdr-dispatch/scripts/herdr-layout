#!/usr/bin/env python3
# herdr-layout — 将指定标签页调整为「主对话窗格居左 + 工作 Agent 右侧网格」
#
# 用法：
#   herdr-layout                     # 调整当前标签页的布局（herdr 内运行，读 HERDR_TAB_ID）
#   herdr-layout --tab wZ:t5         # 调整指定标签页
#   herdr-layout --main wZ:p22       # 明确指定主对话窗格（默认取标签页里没有任务名的窗格）
#   herdr-layout --ratio 0.4         # 主对话窗格宽度占比（默认 0.4）
#   herdr-layout --dry-run           # 仅输出计划中的移动步骤，不修改当前布局
#
# 布局规则：主对话窗格占据左侧全高；其余窗格在右侧排两行网格（1 个窗格占据右侧全高，
#           2 个=上下，3 至 4 个窗格使用 2×2 网格，5-6 个=2×3，按列均分）。
#
# 安全限制：只用非破坏原语：pane.move（移动现有窗格，不终止其中的进程）+
# layout.set_split_ratio（只调比例）。严禁 layout.apply——它的语义是按模板
# 新建标签页替换旧标签页，会连窗格带进程一起关掉（2026-07-09 曾导致现有窗格及进程被关闭）。
# 同标签页内直接 move 无效，必须先 --new-tab 经临时标签页移动后返回原标签页。

import argparse, json, os, socket, subprocess, sys, uuid

SOCK = os.path.expanduser("~/.config/herdr/herdr.sock")


def call(method, params):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(10)
    s.connect(SOCK)
    req = {"id": f"xk:layout:{uuid.uuid4().hex[:8]}", "method": method, "params": params}
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while b"\n" not in buf:
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    resp = json.loads(buf.decode().split("\n")[0])
    if "error" in resp:
        raise RuntimeError(f"{method} 失败：{resp['error']}")
    return resp["result"]


def cli(*args):
    r = subprocess.run(["herdr", *args], capture_output=True, text=True)
    out = r.stdout.strip() or r.stderr.strip()
    try:
        d = json.loads(out)
    except ValueError:
        raise RuntimeError(f"herdr {' '.join(args)} 输出不可解析：{out[:200]}")
    if d.get("error"):
        raise RuntimeError(f"herdr {' '.join(args)} 失败：{d['error']}")
    return d.get("result", {})


def leaf_panes(node, out):
    if node["type"] == "pane":
        out.append(node["pane_id"])
    else:
        leaf_panes(node["first"], out)
        leaf_panes(node["second"], out)


def plan_moves(main_pane, agents):
    """生成移动步骤。列结构：[A1,A2] | [A3,A4] | ...（每列两行）"""
    cols = [agents[i:i + 2] for i in range(0, len(agents), 2)]
    moves = []       # (pane, split, target)
    anchor = main_pane
    for c in cols:
        moves.append((c[0], "right", anchor))
        anchor = c[0]
    for c in cols:
        if len(c) == 2:
            moves.append((c[1], "down", c[0]))
    return moves


def plan_grid(panes):
    """无主对话窗格的均分网格：每列两行，保留第一个窗格作为基准窗格。

    2 格 = 上下；3 格 = 左列上下 + 右列整块；4 格 = 2×2 网格。
    每列两行而不是横排四列，是因为 Agent 的 TUI 需要足够宽度，列宽过小时内容难以阅读。
    """
    cols = [panes[i:i + 2] for i in range(0, len(panes), 2)]
    moves = []
    anchor = cols[0][0]
    for c in cols[1:]:
        moves.append((c[0], "right", anchor))
        anchor = c[0]
    for c in cols:
        if len(c) == 2:
            moves.append((c[1], "down", c[0]))
    return moves


def grid_cols(node):
    """网格意义上的列数：right 分割累加，leaf / down 分割算一列。"""
    if node["type"] == "pane" or node["direction"] != "right":
        return 1
    return grid_cols(node["first"]) + grid_cols(node["second"])


def fix_ratios(tab_id, main_ratio=None):
    """按实际树结构调比例：right 分割按列数均分，down 对半。

    提供 main_ratio 时，将其作为根节点的分割比例（主对话窗格占比）；给 None 表示无主对话窗格，
    根分割也按列数均分。
    """
    root = call("layout.export", {"tab_id": tab_id})["layout"]["root"]
    if root["type"] != "split":
        return
    todo = []
    def walk(node, path):
        if node["type"] != "split":
            return
        if not path and main_ratio is not None:
            todo.append(([], main_ratio))
        elif node["direction"] == "right":
            todo.append((path, grid_cols(node["first"]) / grid_cols(node)))
        else:
            todo.append((path, 0.5))
        walk(node["first"], path + [False])
        walk(node["second"], path + [True])
    walk(root, [])
    for path, ratio in todo:
        try:
            call("layout.set_split_ratio", {"tab_id": tab_id, "path": path, "ratio": ratio})
        except RuntimeError:
            pass  # 个别比例失败不影响窗格本身


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tab", default=os.environ.get("HERDR_TAB_ID"))
    ap.add_argument("--main", dest="main_pane")
    ap.add_argument("--ratio", type=float, default=0.4)
    ap.add_argument("--grid", action="store_true",
                    help="无主对话窗格的工作标签页：全部窗格均分网格（开发或审查标签页使用）")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    exported = call("layout.export", {"tab_id": args.tab})["layout"]
    tab_id = exported["tab_id"]
    ws_id = exported["workspace_id"]
    all_panes = []
    leaf_panes(exported["root"], all_panes)

    if len(all_panes) < 2:
        print(f"标签页 {tab_id} 只有 {len(all_panes)} 个窗格，无需调整布局")
        return

    if args.grid:
        # 工作标签页：没有主对话窗格，全部窗格均已关联具名 Agent，保留第一个窗格作为基准窗格
        main_pane = None
        anchor = all_panes[0]
        agents = all_panes[1:]
        moves = plan_grid(all_panes)
    else:
        main_pane = args.main_pane
        if not main_pane:
            agents_info = cli("agent", "list").get("agents", [])
            named = {a.get("pane_id") for a in agents_info if a.get("name")}
            # 有标签的窗格也不算主对话窗格候选（恢复现场时用 pane rename 打过任务名）
            panes_info = cli("pane", "list", "--workspace", ws_id).get("panes", [])
            labeled = {p.get("pane_id") for p in panes_info if p.get("label")}
            candidates = [p for p in all_panes if p not in named and p not in labeled]
            if not candidates:
                sys.exit(f"标签页 {tab_id} 里全部窗格均已关联具名 Agent，请用 --main 指定主对话窗格")
            focused = exported.get("focused_pane_id")
            main_pane = focused if focused in candidates else candidates[0]
        if main_pane not in all_panes:
            sys.exit(f"主对话窗格 {main_pane} 不在标签页 {tab_id} 里")
        anchor = main_pane
        agents = [p for p in all_panes if p != main_pane]
        moves = plan_moves(main_pane, agents)

    if args.dry_run:
        print(json.dumps({"tab_id": tab_id, "模式": "均分网格" if args.grid else "主对话窗格居左",
                          "基准窗格": anchor,
                          "计划移动步骤": [f"{p} --split {d} → {t}" for p, d, t in moves]},
                         ensure_ascii=False, indent=1))
        return

    # 1. 全部 Agent 窗格移动到临时标签页（同标签页内 move 无效，必须中转）
    first = cli("pane", "move", agents[0], "--new-tab", "--workspace", ws_id,
                "--label", "布局中转", "--no-focus")
    mv = first.get("move_result", first)
    tmp_tab = (mv.get("created_tab") or {}).get("tab_id") or \
              (mv.get("pane") or {}).get("tab_id")
    if not tmp_tab:
        sys.exit(f"临时标签页创建失败：{json.dumps(first)[:300]}")
    for p in agents[1:]:
        cli("pane", "move", p, "--tab", tmp_tab, "--split", "right", "--no-focus")

    # 2. 按列移回原标签页，挂到基准窗格上
    for p, direction, target in moves:
        cli("pane", "move", p, "--tab", tab_id, "--split", direction,
            "--target-pane", target, "--no-focus")

    # 3. 临时标签页中的窗格全部移出后若还在，关掉（空标签页，无进程）
    try:
        cli("tab", "close", tmp_tab)
    except RuntimeError:
        pass

    # 4. 调比例：有主对话窗格时根 = 主对话窗格占比，无主对话窗格时整棵树按网格均分
    fix_ratios(tab_id, None if args.grid else args.ratio)

    if args.grid:
        print(f"布局已调整：{tab_id} 均分网格 {len(all_panes)} 格")
    else:
        print(f"布局已调整：{tab_id} 主对话窗格 {main_pane} 左 {int(args.ratio*100)}%，右侧 {len(agents)} 格网格")


if __name__ == "__main__":
    main()
